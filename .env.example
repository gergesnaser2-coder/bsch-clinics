# ========================================================================
# BSCH Clinics — مستشفى الأطفال التخصصي بالبحيرة
# Supabase & Application Environment Configuration
# ========================================================================

# Supabase public keys (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key-here"

# Supabase Service Role / Secret Key (Server-only operations, NEVER expose to browser)
SUPABASE_SECRET_KEY="your-supabase-service-role-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Staff Authentication
# Domain appended to staff usernames to build Supabase Auth emails (username@domain)
STAFF_AUTH_DOMAIN="hospital.internal"
# HMAC-SHA256 signing secret for staff session cookies (min 32 chars).
# Generate once: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STAFF_SESSION_SECRET="your-generated-64-plus-char-random-secret-here"
# OPTIONAL: password of the internal admin@hospital.internal account, used only as a
# last-resort server-side session fallback when the service-role key is unavailable.
STAFF_DEFAULT_PASSWORD=""

# Application Base URL
APP_URL="http://localhost:3000"


# Gemini API Key (Server-only secret for AI Studio capabilities)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
